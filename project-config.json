{
  "project": {
    "name": "mi_api",
    "path": ".",
    "version": "0.1.0",
    "description": "API desarrollada con FastAPI",
    "author": "Tu Nombre",
    "email": "tu@email.com",
    "year": 2026
  },
  "dependencies": {
    "main": ["fastapi", "pydantic", "pydantic-settings", "sqlmodel", "uvicorn"],
    "dev": ["bumpver", "pytest", "black", "ruff"]
  },
  "features": {
    "with_tests": true,
    "with_docs": true,
    "with_docker": false
  },
  "database": {
    "engine": "sqlite",
    "url": "sqlite+aiosqlite:///./app.db"
  },
  "templates": {
    "version": "1.0",
    "include": [
      "settings",
      "database",
      "errors",
      "controllers",
      "api"
    ]
  }
}